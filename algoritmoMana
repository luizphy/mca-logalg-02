programa {
   funcao inicio()
 {
    escreva(“Quantidade de poção de cura: “)
    inteiro(pocaoCura)
    leia(pocaoCura)
    inteiro totalCura = pocaoCura * 15

    escreva(“Quantidade de poção de energia: “)
